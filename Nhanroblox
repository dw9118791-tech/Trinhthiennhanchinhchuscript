end

local function btn(p,t,pos,size)
	local b=Instance.new("TextButton",p)
	b.Text=t
	b.Position=pos
	b.Size=size
	b.TextSize=15
	b.Font=Enum.Font.GothamBold
	b.TextColor3=Color3.new(1,1,1)
	b.BackgroundColor3=Color3.fromRGB(28,40,31)
	corner(b,10)
	return b
end

